# EditorConfig — https://editorconfig.org
# Top-most config; do not look for higher-level files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# --- Per-language overrides ---

[*.{py,toml}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Markdown sometimes uses two trailing spaces for line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.{html,css,js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
