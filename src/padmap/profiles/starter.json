{
  "name": "My profile",
  "description": "Starting point written by `padmap init`. Every feature is spelled out \u2014 delete what you don't want. Prefer `padmap setup`, which measures your pad instead of guessing.",
  "poll_hz": 120,
  "device": {
    "match": "xbox",
    "trigger_mode": "auto",
    "auto_centre": true,
    "layout": {}
  },
  "buttons": {
    "a": "mouse:left",
    "b": "mouse:right",
    "x": "key:enter",
    "y": "key:esc",
    "lb": "special:precision",
    "rb": "special:layer:shift",
    "back": "special:toggle_pause",
    "start": "text:hello from padmap",
    "ls": "mouse:middle",
    "rs": "macro:copy-paste"
  },
  "dpad": {
    "up": "key:up",
    "down": "key:down",
    "left": "key:left",
    "right": "key:right"
  },
  "triggers": {
    "lt": {
      "action": "key:page_up",
      "threshold": 0.5,
      "turbo": 6
    },
    "rt": {
      "hysteresis": 0.03,
      "zones": [
        {
          "from": 0.15,
          "to": 0.6,
          "action": "key:page_down",
          "turbo": 4
        },
        {
          "from": 0.6,
          "to": 1.0,
          "action": "key:end"
        }
      ]
    }
  },
  "sticks": {
    "left": {
      "mode": "mouse",
      "speed": 1000,
      "deadzone": 0.1,
      "outer_deadzone": 1.0,
      "curve": 2.0,
      "smoothing": 0.35,
      "accel": 2.5,
      "accel_time": 0.5,
      "precision": 0.22,
      "invert_x": false,
      "invert_y": false
    },
    "right": {
      "mode": "scroll",
      "speed": 14,
      "deadzone": 0.2,
      "smoothing": 0.4
    }
  },
  "layers": {
    "shift": {
      "description": "hold RB for a second set of bindings",
      "buttons": {
        "a": "key:media_play_pause",
        "b": "key:media_volume_mute",
        "x": "key:ctrl+c",
        "y": "key:ctrl+v",
        "lb": "macro:hold-shift-and-click"
      },
      "dpad": {
        "up": "move:0,-25",
        "down": "move:0,25",
        "left": "move:-25,0",
        "right": "move:25,0"
      }
    }
  },
  "macros": {
    "copy-paste": {
      "steps": [
        "key:ctrl+c",
        {
          "wait": 0.05
        },
        "key:ctrl+v"
      ]
    },
    "hold-shift-and-click": {
      "steps": [
        {
          "down": "key:shift"
        },
        "mouse:left",
        {
          "up": "key:shift"
        }
      ],
      "interruptible": true
    }
  }
}
