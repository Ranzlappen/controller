{
  "name": "My profile",
  "description": "Starting point written by `padmap init`. Every option is spelled out — delete what you don't want. Run: padmap run -w -p <this file>",
  "poll_hz": 120,
  "device": {
    "match": "xbox",
    "trigger_mode": "auto",
    "auto_centre": true,
    "layout": {}
  },
  "buttons": {
    "a": "mouse:left",
    "b": "mouse:right",
    "x": "key:enter",
    "y": "key:esc",
    "lb": "special:precision",
    "rb": "special:layer:shift",
    "back": "special:toggle_pause",
    "start": "text:hello from padmap",
    "ls": "mouse:middle",
    "rs": "noop"
  },
  "dpad": {
    "up": "key:up",
    "down": "key:down",
    "left": "key:left",
    "right": "key:right"
  },
  "triggers": {
    "lt": { "action": "key:page_up", "threshold": 0.5, "turbo": 6 },
    "rt": { "action": "key:page_down", "threshold": 0.5, "turbo": 6 }
  },
  "sticks": {
    "left": {
      "mode": "mouse",
      "speed": 1000,
      "deadzone": 0.1,
      "outer_deadzone": 1.0,
      "curve": 2.0,
      "smoothing": 0.35,
      "accel": 2.5,
      "accel_time": 0.5,
      "precision": 0.22,
      "invert_x": false,
      "invert_y": false
    },
    "right": {
      "mode": "scroll",
      "speed": 14,
      "deadzone": 0.2,
      "smoothing": 0.4
    }
  },
  "layers": {
    "shift": {
      "description": "hold RB for a second set of bindings",
      "buttons": {
        "a": "key:media_play_pause",
        "b": "key:media_volume_mute",
        "x": "key:ctrl+c",
        "y": "key:ctrl+v"
      },
      "dpad": {
        "up": { "action": "key:media_volume_up", "turbo": 8 },
        "down": { "action": "key:media_volume_down", "turbo": 8 },
        "left": "key:alt+left",
        "right": "key:alt+right"
      }
    }
  }
}
